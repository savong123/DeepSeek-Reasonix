{
  "apiVersion": "reasonix.io/plugin/v2",
  "name": "live-compact",
  "version": "0.1.0",
  "description": "Opt-in turn-end small context cuts for Studio",
  "provides": [
    {
      "namespace": "plugin/live-compact",
